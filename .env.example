MASAMUNE_GITHUB_APP_ID=
MASAMUNE_GITHUB_PRIVATE_KEY=
MASAMUNE_GITHUB_WEBHOOK_SECRET=
MASAMUNE_GITHUB_API_URL=https://api.github.com

# Zero-cost default provider pair. Free-tier quotas and availability can change.
MASAMUNE_MASA_BASE_URL=https://api.groq.com/openai/v1
MASAMUNE_MASA_API_KEY=
MASAMUNE_MASA_PROVIDER_ID=groq
MASAMUNE_MASA_MODEL=qwen/qwen3.8-27b

MASAMUNE_MUNE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MASAMUNE_MUNE_API_KEY=
MASAMUNE_MUNE_PROVIDER_ID=google
MASAMUNE_MUNE_MODEL=gemini-3.8-flash
MASAMUNE_MUNE_TEMPERATURE=1

MASAMUNE_REQUIRE_INDEPENDENCE=true
MASAMUNE_ALLOW_PRIVATE_REPOSITORIES=false
MASAMUNE_MAX_CONTEXT_BYTES=20000
MASAMUNE_MAX_FILE_BYTES=8000
MASAMUNE_MAX_FILES=10
MASAMUNE_MAX_WEBHOOK_BYTES=2000000
MASAMUNE_REQUEST_TIMEOUT_SECONDS=45
MASAMUNE_MODEL_MAX_OUTPUT_TOKENS=2000
MASAMUNE_HOST=127.0.0.1
MASAMUNE_PORT=8000
MASAMUNE_STATE_DB_PATH=masamune.sqlite3
